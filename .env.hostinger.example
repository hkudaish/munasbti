# Copy to .env.production on the server (chmod 600). Never commit the real file. Generate secrets with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"

NODE_ENV=production
PORT=3000
WEB_CONCURRENCY=2                       # PM2 workers: about one per vCPU

# Public address, https only. Used for same-origin checks, e-mail links and invitation links. Baked into the build.
NEXT_PUBLIC_APP_URL=https://munasbti.biz

# PostgreSQL (required). External managed Postgres (Neon / Supabase / DigitalOcean) needs sslmode=require; local Postgres on the VPS does not.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DB_CONNECTION_LIMIT=10                  # per PM2 worker: keep workers x limit below the database's max connections

# Reverse proxy: number of proxies in front of the app (nginx = 1, Cloudflare + nginx = 2). 0 = trust no forwarded header.
TRUSTED_PROXY_HOPS=1

# Secrets (64 hex characters each). Back them up OUTSIDE the server: losing them makes encrypted data unreadable.
AUTH_ENCRYPTION_KEY=                    # encrypts authenticator-app (2FA) secrets; 2FA is off until this is set
CHANNEL_ENCRYPTION_KEY=                 # encrypts customers' WhatsApp/SMS/e-mail channel credentials
SESSION_SECRET=                         # signs the "known device" cookie
BACKUP_ENCRYPTION_KEY=                  # encrypts backups
BACKUP_CRON_TOKEN=                      # shared secret for the scheduled jobs (cron.sh)
BACKUP_STORAGE_DIR=/var/backups/munasbti   # outside the web root; copy it off the server too

# E-mail (password reset, e-mail verification). Hostinger e-mail: smtp.hostinger.com, port 465.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@munasbti.biz
SMTP_PASS=
MAIL_FROM="Munasbti <no-reply@munasbti.biz>"

# CAPTCHA (Cloudflare Turnstile, free). Leave empty to disable. The site key is public and baked into the build.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional
CATALOG_CACHE_MS=15000
GEOAPIFY_API_KEY=

# Sign-in methods (switched on in the system admin screen "إعدادات تسجيل الدخول والتحقق"; a method with missing variables stays hidden from visitors)
OTP_HMAC_KEY=                           # 64 hex characters: keys the hash of one-time sign-in codes (falls back to SESSION_SECRET)
# Google: https://console.cloud.google.com > APIs & Services > Credentials > OAuth client (Web). Redirect URI: https://munasbti.biz/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: Services ID (APPLE_CLIENT_ID), Team ID, a Sign-in-with-Apple key (.p8). Return URL: https://munasbti.biz/api/auth/oauth/apple/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=                      # contents of the .p8 file with line breaks written as \n
# SMS (Twilio) and WhatsApp (Meta Cloud API, approved AUTHENTICATION template with one code parameter)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMS_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_LANGUAGE=ar

# Neon (managed PostgreSQL): copy both addresses from the Neon console (Connect) or `neon env pull`.
#   DATABASE_URL            the POOLED address (host contains "-pooler"): used by the running app. The app adds pgbouncer=true by itself.
#   DATABASE_URL_UNPOOLED   the DIRECT address: used by scripts/migrate.cjs, seed-base.cjs and provision-system-admin.cjs (advisory locks need a session).
DATABASE_URL_UNPOOLED=
